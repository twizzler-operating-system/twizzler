+static void
+pin_to_cpu(int cpu)
+{
+	cpuset_t mask;
+
+	CPU_ZERO(&mask);
+	CPU_SET(cpu, &mask);
+	if (cpuset_setaffinity(CPU_LEVEL_WHICH, CPU_WHICH_PID, -1,
+	    sizeof(mask), &mask) == -1)
+		_exit(2);
+}
