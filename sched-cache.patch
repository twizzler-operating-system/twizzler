+ *  AC-21: Toggle enabled 0->1 with PMCs busy -- no crash
+ * ================================================================== */
+
+ATF_TC_WITH_CLEANUP(toggle_enable_pmc_busy);
+ATF_TC_HEAD(toggle_enable_pmc_busy, tc)
+{
