+	ATF_REQUIRE(sysctl_read_int(SYSCTL_ENABLED, &val) == 0);
+	ATF_CHECK_MSG(val == 1,
+	    "AC-21: cachemiss_enabled should be 1 after toggle, got %d", val);
+
+	/* Cleanup: disable. */
