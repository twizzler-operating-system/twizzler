+
+/*
+ * Check that a sysctl exists.  Returns 0 on success, -1 on failure.
+ */
+static int
+sysctl_exists(const char *name)
+{
+	size_t sz = 0;
+
+	if (sysctlbyname(name, NULL, &sz, NULL, 0) == -1 &&
+	    errno == ENOENT)
+		return (-1);
+	return (0);
