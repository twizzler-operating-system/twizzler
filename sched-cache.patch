+static int
+get_priority(pid_t pid, unsigned char *pri_level, unsigned char *pri_user)
+{
+	struct kinfo_proc kp;
+	int mib[4];
+	size_t sz;
+
+	mib[0] = CTL_KERN;
+	mib[1] = KERN_PROC;
+	mib[2] = KERN_PROC_PID;
+	mib[3] = pid;
+	sz = sizeof(kp);
+	if (sysctl(mib, 4, &kp, &sz, NULL, 0) == -1)
+		return (-1);
+	if (pri_level != NULL)
+		*pri_level = kp.ki_pri.pri_level;
+	if (pri_user != NULL)
+		*pri_user = kp.ki_pri.pri_user;
+	return (0);
