+//! Implementation for Twizzler, over the runtime ABI's entropy call.
+use core::mem::MaybeUninit;
+
+use crate::Error;
+
+pub use crate::util::{inner_u32, inner_u64};
+
+// `size_t twz_rt_get_random(char *buf, size_t len, uint32_t flags)`, from
+// src/abi/include/twizzler/rt/random.h. Declared directly rather than through
+// twizzler-rt-abi: that crate needs six nightly features, and bootstrap builds tools with a
+// restricted -Zallow-features, so depending on it makes this crate unbuildable inside cargo.
+// Declaring the extern is also what upstream's own backends do -- hermit declares
+// `sys_read_entropy` exactly this way.
+extern "C" {
+    fn twz_rt_get_random(buf: *mut u8, len: usize, flags: u32) -> usize;
+}
+
+#[inline]
+pub fn fill_inner(dest: &mut [MaybeUninit<u8>]) -> Result<(), Error> {
+    // Returns the number of bytes filled. A short read means the runtime could not satisfy the
+    // request; for a blocking call that is a failure, not a partial-fill retry case. Returning
+    // Ok here would hand back uninitialised bytes as entropy.
+    let len = unsafe { twz_rt_get_random(dest.as_mut_ptr().cast::<u8>(), dest.len(), 0) };
+    if len == dest.len() {
+        Ok(())
+    } else {
+        Err(Error::UNEXPECTED)
+    }
+}
